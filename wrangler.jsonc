{
  "name": "strava-webhook",
  "main": "src/worker.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-09-08",
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "STRAVA_CLIENT_ID": "45981",
    "STRAVA_SUBSCRIPTION_ID": "371824",
    "ZAPIER_HOOK_URL": "https://hooks.zapier.com/hooks/catch/28787969/4h7hwss/"
  },
  "kv_namespaces": [
    {
      "id": "7b9cce50c2ee42c78f9e82a86efdeb66",
      "binding": "STRAVA_TOKENS"
    }
  ]
}